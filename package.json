{
  "name": "einvoice-kit",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "rules": "node tools/rules/build.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "coverage": "pnpm --filter @tirlogy/einvoice coverage",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter web e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "xslt3": "2.7.0",
    "fflate": "^0.8.2",
    "typescript": "~6.0.3",
    "eslint": "^10.15.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.74.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "type": "module"
}
