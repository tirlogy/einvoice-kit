# No variables are needed to build or run the app locally.

# Only for the optional preview deploy job in GitHub Actions (repository secrets, never commit values):
# CLOUDFLARE_API_TOKEN=   # API token with "Cloudflare Pages: Edit"
# CLOUDFLARE_ACCOUNT_ID=  # Cloudflare account ID

# Optional: alternative location of the compiled rule files for @tirlogy/einvoice/node
# EINVOICE_RULES_DIR=
